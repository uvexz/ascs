generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Site {
  id                 String         @id @default(cuid())
  hostname           String         @unique
  name               String?
  description        String?
  alternateHostnames String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  comments           Comment[]
  subscriptions      Subscription[]

  @@map("sites")
}

model Comment {
  id               String            @id @default(cuid())
  content          String
  author           String
  email            String?
  website          String?
  pageId           String
  status           CommentStatus     @default(APPROVED)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  siteId           String
  parentId         String?
  parent           Comment?          @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies          Comment[]         @relation("CommentReplies")
  site             Site              @relation(fields: [siteId], references: [id], onDelete: Cascade)
  moderationTokens ModerationToken[]

  @@map("comments")
}

model SystemConfig {
  id    String @id @default(cuid())
  key   String @unique
  value String

  @@map("system_configs")
}

model AIConfig {
  id        String   @id @default(cuid())
  baseUrl   String
  model     String
  apiKey    String
  isEnabled Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("ai_configs")
}

model Subscription {
  id        String   @id @default(cuid())
  email     String
  pageId    String
  siteId    String
  token     String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([email, pageId, siteId])
  @@map("subscriptions")
}

model ModerationToken {
  id        String   @id @default(cuid())
  token     String   @unique
  action    String
  isUsed    Boolean  @default(false)
  createdAt DateTime @default(now())
  expiresAt DateTime
  commentId String
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@map("moderation_tokens")
}

enum CommentStatus {
  APPROVED
  PENDING
  REJECTED
}
