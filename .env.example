# Copy to .env.local for development or .env for Docker. Never commit secrets.
DATABASE_URL=file:./data/ascs.db
# Turso: libsql://your-database.turso.io
DATABASE_AUTH_TOKEN=
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
# Set one trusted ingress header ONLY when the proxy overwrites it.
# Vercel: x-vercel-forwarded-for; Nginx: x-real-ip
TRUSTED_IP_HEADER=
# Development only; never bypasses DNS verification in production.
ALLOW_LOCALHOST_SITE=false
# Optional OAuth; callback: /api/auth/callback/github, /google or /microsoft
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Optional; defaults to "common" (any Microsoft account). Use a tenant id to
# restrict sign-in to a single organization.
MICROSOFT_TENANT_ID=
# Optional SMTP. Use URL-encoded credentials and smtps:// for implicit TLS.
SMTP_URL=
MAIL_FROM=
# Separate random secret (>=32 characters) for /api/v1/cron/mail
CRON_SECRET=
# Optional Cap captcha for sign-in, password reset and comments. Enabled only when both are set.
# CAP_SITE=https://<instance_url>/<site_key>/
# CAP_KEY=<key_secret>
# The widget loads its WASM solver from <instance_url>/assets, derived from
# CAP_SITE by dropping the site-key segment, so the Cap instance must serve
# assets (ENABLE_ASSETS_SERVER=true, @cap.js/wasm 0.0.8+ for hashwx.wasm).
# One-time admin:init only. Remove ADMIN_PASSWORD after initialization.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator
# --- AI spam moderation (System One decision API) ---
# Server-side only. Detection turns on automatically when DECISION_API_KEY is set.
# Get a free key at https://decision.vllm-sr.ai (limits: /docs#rate-limits).
# Never expose this key to the browser or commit a real one.
DECISION_API_KEY=
DECISION_API_URL=https://decision.vllm-sr.ai/v1/systemone
DECISION_MODEL=vllm-sr/d3
# true/false. Defaults to true when DECISION_API_KEY is set, otherwise false.
SPAM_DETECTION_ENABLED=
# Request timeout in ms (1-120000) and retries for retryable errors (0-10).
SPAM_DETECTION_TIMEOUT_MS=15000
SPAM_DETECTION_MAX_RETRIES=1
# Comment body length sent for detection (1-200000).
SPAM_DETECTION_MAX_CONTENT_LENGTH=10000
# Probability thresholds (0-1). Calibrate against real review data.
# Quarantine needs both the spam probability and the spam-class probability.
SPAM_AUTO_QUARANTINE_THRESHOLD=0.95
SPAM_AUTO_QUARANTINE_CLASS_THRESHOLD=0.80
# Auto-approve needs the spam probability low and the normal class probability high.
SPAM_AUTO_APPROVE_THRESHOLD=0.05
SPAM_AUTO_APPROVE_NORMAL_THRESHOLD=0.90
SPAM_PROMOTION_REVIEW_THRESHOLD=0.80
# Risk score (0-5) that sends a comment to human review.
SPAM_RISK_REVIEW_THRESHOLD=3
# Behavior when detection is unavailable: review (keep pending) or quarantine.
SPAM_FAIL_MODE=review
# silent | error | warn | info | debug
SPAM_LOG_LEVEL=info
# Cache identical detections for N seconds; 0 disables the cache.
SPAM_CACHE_TTL_SECONDS=300
